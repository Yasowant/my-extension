{
  "name": "ember-dusk-yasowant",
  "displayName": "Dusk Forge",
  "description": "Two carefully balanced dark and light themes for developers, with readable syntax, distinct HTTP method colours, clear diagnostics and Git diffs. For React, Next.js, TypeScript and Node.js.",
  "version": "1.2.0",
  "publisher": "yasowant",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "nextjs",
    "react",
    "typescript",
    "nodejs",
    "express",
    "rest api",
    "warm",
    "http"
  ],
  "galleryBanner": {
    "color": "#1C1917",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yasowant/my-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Yasowant/my-extension/issues"
  },
  "contributes": {
    "themes": [
      {
        "id": "Dusk Forge",
        "label": "Dusk Forge Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-forge-dark.json"
      },
      {
        "id": "Dusk Forge Light",
        "label": "Dusk Forge Light",
        "uiTheme": "vs",
        "path": "./themes/dusk-forge-light.json"
      }
    ],
    "grammars": [
      {
        "path": "./syntaxes/http-verbs.injection.json",
        "scopeName": "ember-dusk.http-verbs.injection",
        "injectTo": [
          "source.js",
          "source.jsx",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ]
      },
      {
        "path": "./syntaxes/directives.injection.json",
        "scopeName": "ember-dusk.directives.injection",
        "injectTo": [
          "source.js",
          "source.jsx",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ]
      },
      {
        "path": "./syntaxes/http-file.injection.json",
        "scopeName": "ember-dusk.http-file.injection",
        "injectTo": [
          "source.http"
        ]
      }
    ]
  }
}
