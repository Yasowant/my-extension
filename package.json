{
  "name": "ember-dusk-yasowant",
  "displayName": "Dusk Forge",
  "description": "Dark, light and high-contrast themes for React, TypeScript and SQL, with readable selections, code previews, snippets and highlighting diagnostics.",
  "version": "1.6.0",
  "publisher": "yasowant",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "MERN",
    "MEAN",
    "react",
    "angular",
    "typescript",
    "nodejs",
    "express",
    "mongodb",
    "postgresql",
    "sql",
    "nextjs",
    "http",
    "jsx",
    "tsx",
    "syntax highlighting",
    "snippets",
    "high contrast"
  ],
  "galleryBanner": {
    "color": "#141C28",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yasowant/my-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Yasowant/my-extension/issues"
  },
  "contributes": {
    "themes": [
      {
        "id": "Dusk Forge",
        "label": "Dusk Forge Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dusk-forge-dark.json"
      },
      {
        "id": "Dusk Forge Light",
        "label": "Dusk Forge Light",
        "uiTheme": "vs",
        "path": "./themes/dusk-forge-light.json"
      },
      {
        "id": "Dusk Forge High Contrast",
        "label": "Dusk Forge High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/dusk-forge-high-contrast.json"
      }
    ],
    "grammars": [
      {
        "path": "./syntaxes/http-verbs.injection.json",
        "scopeName": "ember-dusk.http-verbs.injection",
        "injectTo": [
          "source.js",
          "source.jsx",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ]
      },
      {
        "path": "./syntaxes/directives.injection.json",
        "scopeName": "ember-dusk.directives.injection",
        "injectTo": [
          "source.js",
          "source.jsx",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ]
      },
      {
        "path": "./syntaxes/http-file.injection.json",
        "scopeName": "ember-dusk.http-file.injection",
        "injectTo": [
          "source.http"
        ]
      }
    ],
    "commands": [
      {
        "command": "duskForge.troubleshoot",
        "title": "Check Highlighting",
        "category": "Dusk Forge"
      },
      {
        "command": "duskForge.developerSetup",
        "title": "Developer Setup",
        "category": "Dusk Forge"
      },
      {
        "command": "duskForge.fileProblems",
        "title": "Current File Problems",
        "category": "Dusk Forge"
      },
      {
        "command": "duskForge.openProblems",
        "title": "Open Problems Panel",
        "category": "Dusk Forge"
      },
      {
        "command": "duskForge.quickFix",
        "title": "Show Quick Fixes",
        "category": "Dusk Forge"
      },
      {
        "command": "duskForge.preview",
        "title": "Preview Code",
        "category": "Dusk Forge"
      },
      {
        "command": "duskForge.chooseTheme",
        "title": "Choose Color Theme",
        "category": "Dusk Forge"
      },
      {
        "command": "duskForge.copyHighlighted",
        "title": "Copy with Syntax Highlighting",
        "category": "Dusk Forge"
      },
      {
        "command": "duskForge.walkthrough",
        "title": "Get Started",
        "category": "Dusk Forge"
      },
      {
        "command": "duskForge.highlightSettings",
        "title": "Open Highlighting Settings",
        "category": "Dusk Forge"
      }
    ],
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/web.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/web.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/react.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/react-ts.json"
      },
      {
        "language": "sql",
        "path": "./snippets/sql.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/web.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/web.json"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "duskForge.copyHighlighted",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_cutcopypaste@20"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "duskForge.start",
        "title": "Get started with Dusk Forge",
        "description": "Choose a theme, preview your code, and check highlighting.",
        "steps": [
          {
            "id": "theme",
            "title": "1. Choose your theme",
            "description": "Select Dark, Light or High Contrast. Preview colours before confirming.\n[Choose theme](command:duskForge.chooseTheme)",
            "media": {
              "image": "images/react-jsx-preview.png",
              "altText": "Rendered React example in Dusk Forge Dark and Light."
            },
            "completionEvents": [
              "onCommand:duskForge.chooseTheme"
            ]
          },
          {
            "id": "preview",
            "title": "2. Preview real code",
            "description": "Open an unsaved sample for React, Angular, Express, SQL or JSON. Samples are not executed.\n[Preview code](command:duskForge.preview)",
            "media": {
              "image": "images/react-jsx-preview.png",
              "altText": "Rendered React example in Dusk Forge Dark and Light."
            },
            "completionEvents": [
              "onCommand:duskForge.preview"
            ]
          },
          {
            "id": "check",
            "title": "3. Resolve colour differences",
            "description": "Inspect language mode and settings overrides. Your settings are never changed automatically.\n[Check highlighting](command:duskForge.troubleshoot)",
            "media": {
              "image": "images/react-jsx-preview.png",
              "altText": "Rendered React example in Dusk Forge Dark and Light."
            },
            "completionEvents": [
              "onCommand:duskForge.troubleshoot"
            ]
          },
          {
            "id": "tools",
            "title": "4. Explore developer tools",
            "description": "Discover snippets and existing language-tool diagnostics.\n[Explore tools](command:duskForge.developerSetup)",
            "media": {
              "image": "images/react-jsx-preview.png",
              "altText": "Rendered React example in Dusk Forge Dark and Light."
            },
            "completionEvents": [
              "onCommand:duskForge.developerSetup"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node tests/highlighting.cjs && node tests/contrast.cjs && node tests/toolkit.cjs",
    "test:integration": "node tests/run-integration.cjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "main": "./src/extension.js",
  "browser": "./src/extension.js",
  "activationEvents": [
    "onCommand:duskForge.troubleshoot",
    "onCommand:duskForge.developerSetup",
    "onCommand:duskForge.fileProblems",
    "onCommand:duskForge.openProblems",
    "onCommand:duskForge.quickFix",
    "onCommand:duskForge.preview",
    "onCommand:duskForge.chooseTheme",
    "onCommand:duskForge.copyHighlighted",
    "onCommand:duskForge.walkthrough",
    "onCommand:duskForge.highlightSettings"
  ],
  "homepage": "https://github.com/Yasowant/my-extension#readme"
}
