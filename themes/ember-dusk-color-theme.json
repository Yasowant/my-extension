  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#948271",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSDoc / docblock tags",
      "scope": [
        "comment.block.documentation storage.type",
        "comment.block.documentation entity.name.type",
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#A89272"
      }
    },
    {
      "name": "Base text, variables, object properties",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "meta.object-literal.key",
        "support.variable.property",
        "variable.other.object.property",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#E6D9C9"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable.other.readwrite",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#D6C3AC"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.trycatch",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.default",
        "keyword.control.as",
        "keyword.other.debugger",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.expression",
        "keyword.operator.of",
        "keyword.operator.in",
        "keyword.operator.instanceof",
        "keyword.operator.typeof",
        "keyword.operator.void",
        "keyword.control.satisfies",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#E07B5F"
      }
    },
    {
      "name": "Storage: const, let, var, function, class, async, await",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "storage.type.class",
        "storage.type.function",
        "storage.type.namespace",
        "keyword.control.async",
        "storage.modifier.async",
        "storage.type.property"
      ],
      "settings": {
        "foreground": "#CE8E9E"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#A5B86B"
      }
    },
    {
      "name": "Template literal interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.embedded.line"
      ],
      "settings": {
        "foreground": "#E07B5F"
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#D9A066"
      }
    },
    {
      "name": "Numbers, booleans, null, undefined, constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nan",
        "constant.language.infinity",
        "support.constant",
        "variable.other.constant",
        "variable.language.this",
        "variable.language.super",
        "variable.language.arguments"
      ],
      "settings": {
        "foreground": "#CE8E9E"
      }
    },
    {
      "name": "Function and method declarations",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "meta.definition.method entity.name.function",
        "variable.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#E5B25D"
      }
    },
    {
      "name": "Node globals and built-ins",
      "scope": [
        "support.class.node",
        "support.variable.object.node",
        "support.type.object.module",
        "support.variable.object.process",
        "support.class.console",
        "support.function.console",
        "variable.other.object.process",
        "support.variable.dom",
        "support.variable.object.dom",
        "support.class.builtin",
        "support.class.error"
      ],
      "settings": {
        "foreground": "#7FB8A8"
      }
    },
    {
      "name": "Classes, types, interfaces, enums, React components",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.alias",
        "entity.name.type.module",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.parameter",
        "meta.type.annotation entity.name.type",
        "meta.return.type entity.name.type"
      ],
      "settings": {
        "foreground": "#7FB8A8"
      }
    },
    {
      "name": "Primitive type annotations",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "keyword.operator.type",
        "meta.type.annotation support.type.primitive"
      ],
      "settings": {
        "foreground": "#8FC4B4"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.decorator punctuation.decorator",
        "meta.decorator variable.other.readwrite",
        "tag.decorator.js entity.name.tag.js"
      ],
      "settings": {
        "foreground": "#D3A46A"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
